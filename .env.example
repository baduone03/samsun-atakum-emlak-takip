# Bu dosyayi ".env" olarak kopyala ve degerleri doldur.
# .env dosyasi .gitignore'da - asla repoya girmez.
#
# Bot token: Telegram'da @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Chat id: bota mesaj at, sonra
# https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
TELEGRAM_CHAT_ID=123456789
